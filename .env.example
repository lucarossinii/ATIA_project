# Copia questo file in .env e inserisci i tuoi valori.
# Il file .env è escluso da git: non committarlo mai.

# Chiave dell'API Google Gemini (obbligatoria)
API_KEY=

# Modello Gemini da usare (facoltativo, predefinito gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Con 1 stampa nella Command Window le 3 classi più probabili di ogni foto
# analizzata, per capire perché un ingrediente viene scartato (facoltativo)
# DIAGNOSTICA=1
